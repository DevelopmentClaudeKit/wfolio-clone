# Postgres
DATABASE_URL=postgres://wfolio:wfolio@localhost:5432/wfolio

# Public base URL of the app (used in emails and share links)
APP_URL=http://localhost:3000

# Secret for signing gallery-access cookies (any long random string)
APP_SECRET=change-me-to-a-long-random-string

# Object storage: "s3" (AWS S3, Cloudflare R2, MinIO...) or "local" (files on disk, dev only)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage

# S3 / R2 settings (used when STORAGE_DRIVER=s3)
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=wfolio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional SMTP for "client submitted favorites" emails. Without it, emails are logged to the console.
SMTP_URL=
MAIL_FROM="WFolio Clone <no-reply@example.com>"
